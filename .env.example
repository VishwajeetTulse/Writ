# Writ — environment
# Copy to .env and fill in. .env is gitignored; never commit real keys.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL="file:./dev.db"

# ---------------------------------------------------------------------------
# Mandate signing
# ---------------------------------------------------------------------------
# HMAC-SHA256 key for signing mandates. Any random string of 32+ characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Changing this invalidates every mandate already signed — by design. The signature is
# what proves a mandate's terms are the terms a human agreed to.
MANDATE_SIGNING_KEY=""

# ---------------------------------------------------------------------------
# Razorpay — TEST MODE ONLY
# ---------------------------------------------------------------------------
# Dashboard -> Settings -> API Keys -> Generate Test Key.
# Writ refuses to start against a live key: test key ids begin with rzp_test_.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Dashboard -> Settings -> Webhooks. Set the same secret here and there.
# Webhooks whose HMAC does not verify are rejected before the payload is parsed.
RAZORPAY_WEBHOOK_SECRET=""

# ---------------------------------------------------------------------------
# Sign-in (Google)
# ---------------------------------------------------------------------------
# Signs the session cookie. Any random string of 32+ characters.
# Generate one with:  npx auth secret     (or the node one-liner above)
AUTH_SECRET=""

# console.cloud.google.com -> APIs & Services -> Credentials
#   -> Create credentials -> OAuth client ID -> Web application
#
# Authorised redirect URI, exactly:
#   http://localhost:3000/api/auth/callback/google
#
# Add your deployed origin's equivalent too if you ever host this.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ---------------------------------------------------------------------------
# Anthropic
# ---------------------------------------------------------------------------
# console.anthropic.com -> API keys. Used by the mandate drafter, the buyer agent,
# and the verdict explainer. Never by the policy engine.
ANTHROPIC_API_KEY=""
